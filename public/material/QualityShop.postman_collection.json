{
  "info": {"name": "QualityShop — primeira edição", "description": "Execute somente no laboratório local. A sequência cria um produto próprio, consulta, altera e exclui esse produto. Dados fictícios. A API didática de produtos não exige token.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000/api/v1"}, {"key": "product_id", "value": ""}],
  "item": [
    {"name": "01 — Listar produtos ativos", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products?active=1"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Consulta retorna 200', () => pm.response.to.have.status(200));", "pm.test('Resposta contém lista data', () => pm.expect(pm.response.json().data).to.be.an('array'));"], "type": "text/javascript"}}]},
    {"name": "02 — Criar produto da coleção", "event": [{"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('test_sku', 'PM-' + Date.now());", "pm.collectionVariables.unset('product_id');"], "type": "text/javascript"}}, {"listen": "test", "script": {"exec": ["pm.test('Criação retorna 201', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) pm.collectionVariables.set('product_id', pm.response.json().data.id);"], "type": "text/javascript"}}], "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"sku\": \"{{test_sku}}\",\n  \"name\": \"Produto da coleção QA\",\n  \"category\": \"Laboratório\",\n  \"description\": \"Dado fictício criado pelo leitor\",\n  \"price\": 60,\n  \"stock\": 10,\n  \"active\": true\n}", "options": {"raw": {"language": "json"}}}, "url": "{{base_url}}/products"}},
    {"name": "03 — Consultar produto criado", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products/{{product_id}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Consulta retorna 200', () => pm.response.to.have.status(200));", "pm.test('SKU corresponde à criação', () => pm.expect(pm.response.json().data.sku).to.eql(pm.collectionVariables.get('test_sku')));"], "type": "text/javascript"}}]},
    {"name": "04 — Recusar preço negativo", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products/{{product_id}}", "body": {"mode": "raw", "raw": "{\"price\": -1}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Validação retorna 422', () => pm.response.to.have.status(422));", "pm.test('Erro identifica price', () => pm.expect(pm.response.json().errors).to.have.property('price'));"], "type": "text/javascript"}}]},
    {"name": "05 — Atualizar estoque", "request": {"method": "PATCH", "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products/{{product_id}}", "body": {"mode": "raw", "raw": "{\"stock\": 7}", "options": {"raw": {"language": "json"}}}}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Atualização retorna 200', () => pm.response.to.have.status(200));", "pm.test('Estoque alterado', () => pm.expect(pm.response.json().data.stock).to.eql(7));"], "type": "text/javascript"}}]},
    {"name": "06 — Excluir somente o produto da coleção", "request": {"method": "DELETE", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products/{{product_id}}"}, "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.collectionVariables.get('product_id')) throw new Error('Execute a criação antes da exclusão.');"], "type": "text/javascript"}}, {"listen": "test", "script": {"exec": ["pm.test('Exclusão retorna 204', () => pm.response.to.have.status(204));"], "type": "text/javascript"}}]},
    {"name": "07 — Confirmar ausência", "request": {"method": "GET", "header": [{"key": "Accept", "value": "application/json"}], "url": "{{base_url}}/products/{{product_id}}"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Produto excluído retorna 404', () => pm.response.to.have.status(404));"], "type": "text/javascript"}}]}
  ]
}
